# ═══════════════════════════════════════════════════════════════
# FootStats — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=footstats
DATABASE_USER=footstats
DATABASE_PASSWORD=footstats_dev
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka / Redpanda ────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Meilisearch ──────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=footstats_master_key

# ─── ML Service ──────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Data Provider API Keys ──────────────────────────────────
# Leave empty to use mock data provider
SPORTMONKS_API_KEY=
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
GUARDIAN_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
